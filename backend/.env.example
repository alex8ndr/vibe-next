# Copy this file to .env and fill in API keys

# Last.fm API key (for genre detection and similar artists)
# Get one free at: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Songlink/Odesli API key (optional, increases rate limit from 10 req/min)
# Request at: https://odesli.co/
SONGLINK_API_KEY=

# Development: Speed up FastAPI reloads by caching parsed music data (default: false)
ENABLE_DATA_CACHE=false
